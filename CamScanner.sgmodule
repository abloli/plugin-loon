[Script]
CamScanner 解锁 = type=http-response, pattern=^https:\/\/.*\.(intsig\.net|camscanner\.com), script-path=https://raw.githubusercontent.com/abloli/plugin-loon/main/CamScanner.js, requires-body=true, timeout=10

[MITM]
hostname = *.camscanner.com, *.intsig.net
