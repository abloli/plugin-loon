#!name=CamScanner 解锁黄金会员
#!desc=扫描全能王 解锁黄金会员，解锁部分功能，使用前先开脚本
#!author=chxm1023
#!system=ios

[Script]
http-response ^https:\/\/.*\.(intsig\.net|camscanner\.com) script-path=https://raw.githubusercontent.com/abloli/plugin-loon/main/CamScanner.js, requires-body=true, timeout=10, tag=CamScanner 解锁

[MITM]
hostname = *.camscanner.com, *.intsig.net
